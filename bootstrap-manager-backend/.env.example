# Database Configuration
DATABASE_URL=postgresql://boattour:boattour_password@localhost:5432/boattour_db
POSTGRES_USER=boattour
POSTGRES_PASSWORD=boattour_password
POSTGRES_DB=boattour_db

# JWT Configuration
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Application Settings
DEBUG=True
APP_NAME=Boat Tour Management System

# Paddle (Billing) – siehe https://developer.paddle.com
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRODUCT_ID=
PADDLE_SUCCESS_URL=http://localhost:8080/checkout/erfolg
PADDLE_CANCEL_URL=http://localhost:8080/checkout/abbruch
